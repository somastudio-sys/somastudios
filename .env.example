# Copy to .env.local for local development (never commit .env.local)

# Required for Freudian dream analysis in the diary.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: defaults to gpt-4o-mini (good balance of quality and cost)
# OPENAI_MODEL=gpt-4o-mini

# --- Cloud diary archive (required for permanent dream storage) ---
# Vercel Storage (Neon) or neon.com — connection string for cloud diary archive.
# POSTGRES_URL=postgres://...

# Session signing secret for login cookie (32+ random characters)
# DIARY_SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Password reset emails (Resend — https://resend.com) — required for real emails in production
# 1. Create account at resend.com, add API key
# 2. Verify your domain, set EMAIL_FROM to an address on that domain
# 3. Without this, local dev shows the reset link on screen instead of emailing
# RESEND_API_KEY=re_...
# EMAIL_FROM=Soma <noreply@your-domain.com>

# Legacy single-password data (optional — only for migrating pre-account archives)
# Existing dreams/stories without an owner are assigned to this account on first deploy.
# DIARY_PASSWORD=soma
# DIARY_LEGACY_EMAIL=legacy@soma.local

# Optional: Spotify show page for homepage listen button + embed
# Defaults to Soma Studios: The Dream Experiment if unset
# NEXT_PUBLIC_PODCAST_URL=https://open.spotify.com/show/49Bw4yuSpAVD34m7xwHLy8

# Podcast RSS feed — powers the homepage episode list (server-side fetch)
# From Spotify for Podcasters: Settings → Availability → RSS feed
# PODCAST_RSS_URL=https://anchor.fm/s/your-podcast/podcast/rss
# Or use NEXT_PUBLIC_PODCAST_RSS_URL if you prefer the public env prefix
# NEXT_PUBLIC_PODCAST_RSS_URL=https://anchor.fm/s/your-podcast/podcast/rss

# Canonical site URL (metadata, Open Graph, sitemap, robots). Use your production URL in deploy.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: shown as a mailto link in the site footer when set.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
